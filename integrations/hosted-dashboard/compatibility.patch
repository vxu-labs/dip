@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {metadataBranch} from '../lib/metadata.mjs';
+import {writeTask} from '../lib/task-writes.mjs';
+test('metadata selection falls back only for absent reserved branch',async()=>{
+ const old=globalThis.fetch;
+ try{globalThis.fetch=async()=>Response.json({object:{sha:'a'.repeat(40)}});assert.equal(await metadataBranch('test','org/repo','feature'),'dip/state');
+ globalThis.fetch=async()=>Response.json({message:'missing'},{status:404});assert.equal(await metadataBranch('test','org/repo','feature'),'feature');
+ globalThis.fetch=async()=>Response.json({message:'denied'},{status:403});await assert.rejects(metadataBranch('test','org/repo','feature'),/denied/i);
+ }finally{globalThis.fetch=old;}
+});
+test('v2 writes target metadata head while retaining the selected code branch as provenance',async()=>{
+ const old=globalThis.fetch,sha='a'.repeat(40),blob='b'.repeat(40),tree='c'.repeat(40),next='d'.repeat(40),calls=[];
+ const initial={schemaVersion:1,eventId:'initial',taskId:'task_one',type:'task.create',actor:'user',createdAt:'2026-11-02T00:00:00Z',parents:[],payload:{title:'Shared',kind:'work',status:'ready'}};
+ globalThis.fetch=async(url,options={})=>{const p=new URL(url).pathname,body=options.body?JSON.parse(options.body):null;calls.push({p,body,method:options.method||'GET'});
+  if(p==='/repos/org/repo')return Response.json({permissions:{push:true}});
+  if(p.endsWith('/git/ref/heads/dip%2Fstate'))return Response.json({object:{sha}});
+  if(p.endsWith('/git/commits/'+sha))return Response.json({tree:{sha:tree}});
+  if(p.endsWith('/git/trees/'+tree))return Response.json({tree:[{path:'.dip',type:'tree',sha:blob}]});
+  if(p.endsWith('/git/trees/'+blob))return Response.json({tree:[{path:'events/task_one/initial.json',type:'blob',sha:blob,size:300}]});
+  if(p==='/graphql')return Response.json({data:{repository:{b0:{text:JSON.stringify(initial),byteSize:300,isTruncated:false}}}});
+  if(p.endsWith('/git/blobs'))return Response.json({sha:blob});if(p.endsWith('/git/trees'))return Response.json({sha:tree});if(p.endsWith('/git/commits'))return Response.json({sha:next});
+  if(p.endsWith('/git/refs/heads/dip%2Fstate'))return Response.json({object:{sha:next}});
+  throw Error('Unexpected endpoint '+p);
+ };
+ try{const r=await writeTask({token:'test',login:'user'},{repo:'org/repo',branch:'feature',expectedCommit:sha,action:'updateTask',taskId:'task_one',eventId:'event_11111111-1111-4111-8111-111111111111',patch:{description:'shared change'}});
+ assert.equal(r.dataBranch,'dip/state');assert.equal(r.event.branch,'feature');assert.equal(calls.at(-1).body.force,false);assert.ok(calls.every(c=>!c.p.endsWith('/heads/feature')));
+ }finally{globalThis.fetch=old;}
+});
